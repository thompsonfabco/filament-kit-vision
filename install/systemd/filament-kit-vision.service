[Unit]
Description=filament-kit local AI spool & box label recognition service
After=network.target
PartOf=filament-kit.service

[Service]
Type=simple
User=filament-kit
Group=filament-kit
WorkingDirectory=/opt/filament-kit-vision
Environment="PYTHONUNBUFFERED=1"
Environment="HF_HOME=/var/lib/filament-kit/models/hf_cache"
ExecStart=/opt/filament-kit-vision/.venv/bin/filament-kit-vision serve --host 127.0.0.1 --port 7915
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/filament-kit /etc/filament-kit

[Install]
WantedBy=multi-user.target
