[Unit]
Description=filament-kit-vision Local Filament Label Recognition Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=filament-kit
Group=filament-kit
WorkingDirectory=/opt/filament-kit-vision
Environment=PYTHONUNBUFFERED=1
Environment=FILAMENT_KIT_VISION_STATE_DIR=/var/lib/filament-kit-vision
ExecStart=/opt/filament-kit-vision/.venv/bin/filament-kit-vision serve --host 127.0.0.1 --port 7915 --tier auto
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/filament-kit-vision

[Install]
WantedBy=multi-user.target
